# team-ops persistent browser — DO NOT change casually
# This project always uses the hackathon isolated Brave profile.

HACKATHON_CDP_PORT=9230
HACKATHON_CDP_URL=http://127.0.0.1:9230
RC_BROWSER_PORT=9230
RC_CHROME_ISOLATE_PROJECT=1
RC_BROWSER_ENGINE=brave
AGENT_BROWSER_SESSION=hackathon
# Profile (absolute path resolved at runtime via HACKATHON_ROOT):
#   ~/Desktop/hackathon/browser/profile
# SSO cookies + Discord/GitHub logins live here.
# Never use daily Brave on 9223 for this project.
#
# TAB RULE: never spam new tabs. Reuse/activate existing page for same host.
# open-sites.sh / open-sites.mjs implement reuse-first.
