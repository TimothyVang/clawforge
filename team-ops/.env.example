# team-ops secrets — copy to .env (never commit .env)

# --- GitHub ---
# Prefer: gh auth login
# Or: personal access token with repo + project scopes
GITHUB_TOKEN=
# User or org that owns team repos
GITHUB_OWNER=
# Optional: private|public for bootstrap
GITHUB_VISIBILITY=private

# --- Linear ---
# Official MCP uses OAuth in the client. API key optional for scripts:
# https://linear.app/settings/api
LINEAR_API_KEY=
# Team key / name used in scripts (default Core)
LINEAR_TEAM=Core
# Workspace URL slug (e.g. my-company)
LINEAR_WORKSPACE=

# --- Discord bot (shared) ---
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Default channel for agent posts (snowflake); override per prompt
DISCORD_CHANNEL_STANDUP=
DISCORD_CHANNEL_DEV=
DISCORD_CHANNEL_ALERTS=
DISCORD_CHANNEL_LINEAR=

# --- Browser fallback (hackathon isolated Brave) ---
HACKATHON_CDP_URL=http://127.0.0.1:9230
HACKATHON_CDP_PORT=9230
