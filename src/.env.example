# clawforge config — copy to .env (gitignored). No secrets required to run.
CLAWFORGE_MODEL_BASE_URL=http://localhost:8001/v1
CLAWFORGE_MODEL=clawforge-brain
CLAWFORGE_MODEL_API_KEY=EMPTY
CLAWFORGE_OWNER=TimothyVang
CLAWFORGE_REPO=clawforge
CLAWFORGE_WORK_REPO=tickytalky
CLAWFORGE_PROJECT=1
CLAWFORGE_INTERVAL=60
CLAWFORGE_DRY_RUN=0
# Optional Discord standup (leave blank to skip)
DISCORD_BOT_TOKEN=
CLAWFORGE_DISCORD_CHANNEL=
