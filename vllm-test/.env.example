# Copy to .env and fill. .env is gitignored — never commit real tokens.
# Values below are the CONFIRMED-WORKING config on the DGX Spark (GB10, 2026-07-18):
# vLLM 0.14 + CUDA 13.1, ~57 tok/s steady-state.

# --- Image (arm64/GB10 on the Spark) ---
# vllm-node:latest is prebuilt on the Spark and confirmed to run vLLM on the GB10.
VLLM_IMAGE=vllm-node:latest

# --- Model ---
# Small model = immediate/fallback endpoint. Swap to a local DeepSeek path later.
MODEL=Qwen/Qwen2.5-1.5B-Instruct
SERVED_NAME=clawforge-brain

# --- Serve ---
PORT=8001
GPU_UTIL=0.30
MAX_LEN=8192
SHM_SIZE=16g
EXTRA_ARGS=
# SERVE_CMD default is "vllm serve" (for the nvidia-entrypoint vllm-node image).
# For the official vllm/vllm-openai image, set: SERVE_CMD=

# --- Paths / secrets ---
MODELS_DIR=/data/models
HF_TOKEN=
VLLM_LOGGING_LEVEL=INFO

# NOTE: first request after boot is a slow (~20s) JIT/autotune warmup;
# steady-state is fast. Send a warmup call on startup.
